# Leave both blank to use the local, browser-persisted prototype.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- SMS login (MSG91 OTP widget) — optional -----------------------------------
# "on" shows the "Mobile OTP" sign-in option. Codes are sent from the server.
NEXT_PUBLIC_SMS_LOGIN=
# Server-only. MSG91 -> OTP -> Widget. Keep captcha OFF in the widget settings.
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
# Server-only. The MSG91 account authkey (NOT the widget token auth); used to
# re-verify the widget's access token.
MSG91_AUTH_KEY=
# Server-only. Supabase Project Settings -> API keys -> secret key. Used only by
# /api/auth/sms/* and /api/locations (verified service-area selection).
SUPABASE_SECRET_KEY=

# Server-only. Geoapify Address Autocomplete API key. Never use NEXT_PUBLIC_.
GEOAPIFY_API_KEY=
